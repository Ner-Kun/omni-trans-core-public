/* ========================================
   MODERN DARK THEME - Compact & Vibrant
   ======================================== */

/* ---- GLOBAL ---- */
QMainWindow {
    background-color: #1a1a22;
}

QWidget {
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    font-size: 13px;
    color: #e0e0e4;
}

.QWidget {
    background-color: transparent;
}

QDialog {
    background-color: #1a1a22;
}

/* Focus indicator - remove dotted outline */
*:focus {
    outline: none;
}

/* ---- SCROLLBARS ---- */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 6px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.15);
    min-height: 24px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.28);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 6px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.15);
    min-width: 24px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(255, 255, 255, 0.28);
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* ---- TOOLTIPS ---- */
QToolTip {
    background-color: #2d2d40;
    color: #d0d0d8;
    border: 1px solid #4a4a60;
    border-radius: 6px;
    padding: 5px 8px;
    font-size: 11px;
}

/* ---- STATUS BAR ---- */
QStatusBar {
    background-color: #222230;
    color: #8a8a98;
    border-top: 1px solid #35354a;
    font-size: 11px;
    padding: 0 4px;
}

QStatusBar::item {
    border: none;
}

/* ---- MENU BAR ---- */
QMenuBar {
    background-color: #222230;
    border-bottom: 1px solid #35354a;
    color: #b0b0bc;
    padding: 1px 0px;
}

QMenuBar::item {
    padding: 4px 10px;
    border-radius: 4px;
    margin: 1px 1px;
}

QMenuBar::item:selected {
    background-color: #2d2d40;
    color: #e0e0e4;
}

QMenuBar::item:pressed {
    background-color: #5b8def;
    color: #ffffff;
}

/* ---- MENUS ---- */
QMenu {
    background-color: #252533;
    border: 1px solid #3a3a50;
    border-radius: 8px;
    padding: 3px;
}

QMenu::item {
    padding: 4px 16px 4px 10px;
    border-radius: 4px;
    color: #b0b0bc;
}

QMenu::item:selected {
    background-color: #2d2d40;
    color: #e0e0e4;
}

QMenu::separator {
    height: 1px;
    background-color: #35354a;
    margin: 3px 6px;
}

QMenu::indicator {
    width: 14px;
    height: 14px;
}

QMenu::indicator:checked {
    image: none;
    background-color: #5b8def;
    border-radius: 3px;
}

/* ---- PUSH BUTTONS ---- */
QPushButton {
    background-color: #2d2d40;
    color: #d0d0d8;
    border: 1px solid #3a3a50;
    border-radius: 6px;
    padding: 4px 12px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #353550;
    border-color: #4a4a60;
}

QPushButton:pressed {
    background-color: #3e3e58;
}

QPushButton:disabled {
    background-color: #252533;
    color: #585868;
    border-color: #303045;
}

/* Primary accent button */
QPushButton[cssClass="primary"] {
    background-color: #5b8def;
    color: #ffffff;
    border-color: #5b8def;
}

QPushButton[cssClass="primary"]:hover {
    background-color: #4a7de0;
    border-color: #4a7de0;
}

QPushButton[cssClass="primary"]:pressed {
    background-color: #3a6dd0;
}

QPushButton[cssClass="primary"]:disabled {
    background-color: #252533;
    color: #585868;
    border-color: #303045;
}

/* Danger button */
QPushButton[cssClass="danger"] {
    background-color: #ef5555;
    color: #ffffff;
    border-color: #ef5555;
}

QPushButton[cssClass="danger"]:hover {
    background-color: #e04040;
    border-color: #e04040;
}

QPushButton[cssClass="danger"]:pressed {
    background-color: #d03030;
}

/* Ghost / text-only button */
QPushButton[cssClass="ghost"] {
    background-color: transparent;
    color: #8a8a98;
    border: 1px solid transparent;
}

QPushButton[cssClass="ghost"]:hover {
    color: #e0e0e4;
    background-color: #2d2d40;
    border-color: #3a3a50;
}

QPushButton[cssClass="ghost"]:pressed {
    background-color: #353550;
}

/* Success button */
QPushButton[cssClass="success"] {
    background-color: #45c97a;
    color: #ffffff;
    border-color: #45c97a;
}

QPushButton[cssClass="success"]:hover {
    background-color: #35b96a;
    border-color: #35b96a;
}

QPushButton[cssClass="success"]:pressed {
    background-color: #25a95a;
}

/* ---- TOOL BUTTONS ---- */
QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    color: #b0b0bc;
}

QToolButton:hover {
    background-color: #2d2d40;
    border-color: #3a3a50;
    color: #e0e0e4;
}

QToolButton:pressed {
    background-color: #353550;
}

QToolButton:disabled {
    color: #585868;
}

QToolButton::menu-indicator {
    image: none;
    width: 0px;
}

/* ---- LINE EDIT ---- */
QLineEdit {
    background-color: #222230;
    color: #e0e0e4;
    border: 1px solid #3a3a50;
    border-radius: 6px;
    padding: 3px 7px;
    selection-background-color: #5b8def;
    selection-color: #ffffff;
}

QLineEdit:hover {
    border-color: #4a4a60;
}

QLineEdit:focus {
    border-color: #5b8def;
}

QLineEdit:disabled {
    background-color: #1a1a22;
    color: #707080;
    border-color: #303045;
}

QLineEdit[readOnly="true"] {
    background-color: #1a1a22;
    color: #909098;
    border-color: #303045;
}

/* ---- TEXT EDIT / PLAIN TEXT EDIT ---- */
QTextEdit, QPlainTextEdit {
    background-color: #222230;
    color: #e0e0e4;
    border: 1px solid #3a3a50;
    border-radius: 6px;
    padding: 6px;
    selection-background-color: #5b8def;
    selection-color: #ffffff;
}

QTextEdit:hover, QPlainTextEdit:hover {
    border-color: #4a4a60;
}

QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #5b8def;
}

QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: #1a1a22;
    color: #585868;
    border-color: #303045;
}

/* ---- TEXT BROWSER ---- */
QTextBrowser {
    background-color: #222230;
    color: #b0b0bc;
    border: 1px solid #3a3a50;
    border-radius: 8px;
    padding: 12px;
    selection-background-color: #5b8def;
    selection-color: #ffffff;
}

QTextBrowser a {
    color: #7aa2f7;
    text-decoration: none;
}

QTextBrowser a:hover {
    text-decoration: underline;
}

/* ---- COMBO BOX ---- */
QComboBox {
    background-color: #222230;
    color: #e0e0e4;
    border: 1px solid #3a3a50;
    padding: 3px 7px;
    padding-right: 24px;
    min-height: 18px;
}

QComboBox:hover {
    border-color: #4a4a60;
}

QComboBox:focus {
    border-color: #5b8def;
}

QComboBox:disabled {
    background-color: #1a1a22;
    color: #585868;
    border-color: #303045;
}

QComboBox QAbstractItemView {
    background-color: #252533;
    color: #e0e0e4;
    border: 1px solid #3a3a50;
    padding: 3px;
    selection-background-color: #2d2d40;
    selection-color: #e0e0e4;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 4px 8px;
    border-radius: 4px;
    min-height: 20px;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #2d2d40;
    color: #e0e0e4;
}

/* ---- SPIN BOX ---- */
QSpinBox, QDoubleSpinBox {
    background-color: #222230;
    color: #e0e0e4;
    border: 1px solid #3a3a50;
    padding: 2px 4px;
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #4a4a60;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #5b8def;
}

QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: #1a1a22;
    color: #585868;
    border-color: #303045;
}

/* ---- CHECK BOX ---- */
QCheckBox {
    color: #e0e0e4;
    spacing: 5px;
}

QCheckBox:disabled {
    color: #585868;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 2px solid #4a4a60;
    border-radius: 3px;
    background-color: #222230;
}

QCheckBox::indicator:hover {
    border-color: #5b8def;
}

QCheckBox::indicator:checked {
    background-color: #5b8def;
    border-color: #5b8def;
}

QCheckBox::indicator:checked:hover {
    background-color: #4a7de0;
    border-color: #4a7de0;
}

QCheckBox::indicator:disabled {
    background-color: #1a1a22;
    border-color: #2a2a30;
}

QCheckBox::indicator:checked:disabled {
    background-color: #3a3a40;
    border-color: #3a3a40;
}

/* ---- RADIO BUTTON ---- */
QRadioButton {
    color: #e0e0e4;
    spacing: 5px;
}

QRadioButton:disabled {
    color: #585868;
}

QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 2px solid #4a4a60;
    border-radius: 10px;
    background-color: #222230;
}

QRadioButton::indicator:hover {
    border-color: #5b8def;
}

QRadioButton::indicator:checked {
    background-color: #5b8def;
    border-color: #5b8def;
}

QRadioButton::indicator:checked:hover {
    background-color: #4a7de0;
    border-color: #4a7de0;
}

QRadioButton::indicator:disabled {
    background-color: #1a1a22;
    border-color: #2a2a30;
}

QRadioButton::indicator:checked:disabled {
    background-color: #3a3a40;
    border-color: #3a3a40;
}

/* ---- GROUP BOX ---- */
QGroupBox {
    background-color: #1e1e2a;
    border: 1px solid #303045;
    border-radius: 8px;
    margin-top: 5px;
    padding-top: 8px;
    padding-bottom: 3px;
    padding-left: 6px;
    padding-right: 6px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 1px 6px;
    color: #c0c0cc;
    background-color: #28283a;
    border: 1px solid #35354a;
    border-radius: 4px;
    left: 10px;
}

/* ---- LABELS ---- */
QLabel {
    color: #e0e0e4;
    background-color: transparent;
}

QLabel:disabled {
    color: #707080;
}

/* ---- SLIDER ---- */
QSlider::groove:horizontal {
    height: 4px;
    background-color: #35354a;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: #5b8def;
    border: none;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background-color: #4a7de0;
}

QSlider::handle:horizontal:pressed {
    background-color: #3a6dd0;
}

QSlider::sub-page:horizontal {
    background-color: #5b8def;
    border-radius: 2px;
}

QSlider::groove:vertical {
    width: 4px;
    background-color: #35354a;
    border-radius: 2px;
}

QSlider::handle:vertical {
    background-color: #5b8def;
    border: none;
    width: 14px;
    height: 14px;
    margin: 0 -5px;
    border-radius: 7px;
}

QSlider::handle:vertical:hover {
    background-color: #4a7de0;
}

QSlider::sub-page:vertical {
    background-color: #5b8def;
    border-radius: 2px;
}

QSlider:disabled {
    background-color: transparent;
}

QSlider::handle:horizontal:disabled {
    background-color: #3a3a40;
}

QSlider::sub-page:horizontal:disabled {
    background-color: #3a3a40;
}

/* ---- PROGRESS BAR ---- */
QProgressBar {
    background-color: #303045;
    border: 1px solid #3a3a50;
    border-radius: 4px;
    text-align: center;
    color: #e0e0e4;
    font-weight: 600;
    min-height: 16px;
}

QProgressBar::chunk {
    background-color: #5b8def;
    border-radius: 3px;
}

/* ---- TAB WIDGET ---- */
QTabWidget::pane {
    background-color: #1a1a22;
    border: 1px solid #303045;
    border-radius: 6px;
    top: -1px;
}

QTabBar::tab {
    background-color: #28283a;
    color: #8a8a98;
    border: 1px solid #303045;
    padding: 4px 10px;
    margin-right: 1px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background-color: #1a1a22;
    color: #e0e0e4;
    border-bottom-color: #1a1a22;
}

QTabBar::tab:hover:!selected {
    background-color: #2d2d40;
    color: #b0b0bc;
}

QTabBar::tab:disabled {
    color: #585868;
    background-color: #1a1a1e;
}

/* ---- TABLE WIDGET ---- */
QTableWidget {
    background-color: #1e1e2a;
    alternate-background-color: #222230;
    color: #e0e0e4;
    border: 1px solid #303045;
    border-radius: 6px;
    gridline-color: #28283a;
    outline: none;
}

QTableWidget::item:selected {
    background-color: #2d2d40;
    color: #e0e0e4;
}

QHeaderView {
    background-color: transparent;
    border: none;
}

QHeaderView::section {
    background-color: #222230;
    color: #8a8a98;
    border: none;
    border-bottom: 1px solid #303045;
    border-right: 1px solid #303045;
    padding: 3px 5px;
    font-weight: 600;
}

QHeaderView::section:hover {
    background-color: #28283a;
    color: #b0b0bc;
}

QHeaderView::section:last {
    border-right: none;
}

QTableCornerButton::section {
    background-color: #222230;
    border: none;
    border-bottom: 1px solid #303045;
    border-right: 1px solid #303045;
}

/* ---- LIST WIDGET ---- */
QListWidget {
    background-color: transparent;
    border: none;
    outline: none;
    padding: 3px;
}

QListWidget::item {
    padding: 4px 6px;
    border-radius: 4px;
    color: #b0b0bc;
    margin-bottom: 0px;
}

QListWidget::item:selected {
    background-color: #2d2d40;
    color: #e0e0e4;
}

QListWidget::item:hover:!selected {
    background-color: #252533;
    color: #e0e0e4;
}

/* ---- TREE WIDGET ---- */
QTreeWidget {
    background-color: #1e1e2a;
    alternate-background-color: #222230;
    color: #e0e0e4;
    border: 1px solid #303045;
    border-radius: 6px;
    outline: none;
}

QTreeWidget::item {
    padding: 3px;
}

QTreeWidget::item:selected {
    background-color: #2d2d40;
    color: #e0e0e4;
}

QTreeWidget::item:hover {
    background-color: #252533;
}

QTreeWidget::branch {
    background-color: transparent;
}

QTreeWidget::branch:hover {
    background-color: #252533;
}

QTreeWidget::branch:selected {
    background-color: #2d2d40;
}

/* ---- SPLITTER ---- */
QSplitter::handle {
    background-color: #303045;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter::handle:hover {
    background-color: #5b8def;
}

/* ---- MESSAGE BOX ---- */
QMessageBox {
    background-color: #1a1a22;
}

QMessageBox QLabel {
    color: #e0e0e4;
}

QMessageBox QPushButton {
    min-width: 70px;
    padding: 4px 12px;
    background-color: #2d2d40;
    color: #e0e0e4;
    border: 1px solid #3a3a50;
    border-radius: 6px;
}

QMessageBox QPushButton:hover {
    background-color: #353550;
}

QMessageBox QPushButton:pressed {
    background-color: #3e3e58;
}

/* ---- FILE DIALOG ---- */
QFileDialog {
    background-color: #1a1a22;
}

QFileDialog QListView,
QFileDialog QTreeView {
    background-color: #1e1e2a;
    alternate-background-color: #222230;
    color: #e0e0e4;
    border: 1px solid #303045;
    border-radius: 6px;
}

QFileDialog QListView::item:selected,
QFileDialog QTreeView::item:selected {
    background-color: #2d2d40;
    color: #e0e0e4;
}

QFileDialog QListView::item:hover,
QFileDialog QTreeView::item:hover {
    background-color: #252533;
}

QFileDialog QLineEdit {
    background-color: #222230;
    color: #e8e8f0;
    border: 1px solid #3a3a50;
    border-radius: 6px;
    padding: 4px 8px;
}

QFileDialog QToolButton {
    background-color: #28283a;
    border: 1px solid #3a3a50;
    border-radius: 4px;
    padding: 4px;
}

QFileDialog QToolButton:hover {
    background-color: #2a2a3e;
}

QFileDialog QPushButton {
    background-color: #2d2d40;
    color: #e0e0e4;
    border: 1px solid #3a3a50;
    border-radius: 6px;
    padding: 4px 12px;
}

QFileDialog QPushButton:hover {
    background-color: #353550;
}

QFileDialog QComboBox {
    background-color: #222230;
    color: #e0e0e4;
    border: 1px solid #3a3a50;
    border-radius: 6px;
    padding: 3px 7px;
}

/* ---- INPUT DIALOG ---- */
QInputDialog {
    background-color: #1a1a22;
}

QInputDialog QLabel {
    color: #e0e0e4;
}

QInputDialog QLineEdit {
    background-color: #222230;
    color: #e0e0e4;
    border: 1px solid #3a3a50;
    border-radius: 6px;
    padding: 4px 8px;
}

/* ---- DIALOG BUTTON BOX ---- */
QDialogButtonBox QPushButton {
    min-width: 70px;
    padding: 4px 12px;
}

/* ---- STACKED WIDGET ---- */
QStackedWidget {
    background-color: transparent;
}

QStackedWidget > QWidget {
    background-color: #1a1a22;
}

/* ---- FRAME ---- */
QFrame[frameShape="4"], /* HLine */
QFrame[frameShape="5"]  /* VLine */ {
    color: #303045;
    background-color: #303045;
    border: none;
    max-height: 1px;
}

/* ---- MULTI CONNECTION TABLE ROW SELECTION ---- */
QWidget[connectionRowSelected="true"] {
    background-color: #2d2d40;
    border: 1px solid #5b8def;
    border-radius: 4px;
}

/* ---- ABSTRACT SCROLL AREA ---- */
QAbstractScrollArea {
    background-color: #1e1e2a;
    border: 1px solid #303045;
    border-radius: 6px;
}

QAbstractScrollArea::corner {
    background-color: #1e1e2a;
    border: none;
}

/* Make background inside QScrollArea dark */
QScrollArea {
    background-color: transparent;
    border: none;
}

/* qt_scrollarea_viewport - internal canvas */
QWidget#qt_scrollarea_viewport {
    background-color: #1a1a22;
}

/* Protection for container widgets inside tabs */
QTabWidget > QWidget {
    background-color: #1a1a22;
}

/* ---- SIZE GRIP ---- */
QSizeGrip {
    background-color: transparent;
    width: 10px;
    height: 10px;
}

/* ---- HELP TOOLTIP ---- */
HelpTooltip {
    background-color: #383842;
    border: 1px solid #555;
    border-radius: 4px;
    color: #e0e0e0;
    padding: 8px;
}

HelpTooltip a {
    color: #7aa2f7;
}

/* ---- INFO BUTTON ---- */
InfoButton {
    background-color: transparent;
    border: 1px solid #888;
    color: #888;
    font-size: 11px;
    font-weight: bold;
    padding: 0px;
    border-radius: 9px;
}

InfoButton:hover {
    color: #50fa7b;
    border-color: #50fa7b;
}

/* ---- TOAST NOTIFICATION ---- */
ToastNotification {
    background-color: #2d2d42;
    border: 1px solid #4a4a60;
    border-radius: 8px;
}

ToastNotification QLabel {
    color: #e0e0e4;
    font-size: 13px;
}

ToastNotification QPushButton#action_button {
    background-color: #5b8def;
    color: #ffffff;
    border: 1px solid #5b8def;
    border-radius: 4px;
    padding: 5px 12px;
    font-weight: bold;
}

ToastNotification QPushButton#action_button:hover {
    background-color: #4a7de0;
}

ToastNotification QPushButton#close_button {
    border: none;
    background: transparent;
    color: #b0b0bc;
    font-size: 18px;
    font-weight: bold;
    border-radius: 10px;
    padding: 0px;
}

ToastNotification QPushButton#close_button:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: #e0e0e4;
}

/* Toast type-specific styles - INFO */
ToastNotification[type="info"] {
  background-color: #44689e;
  border: 1px solid #5578ae;
  border-radius: 8px;
}

ToastNotification[type="info"] QLabel {
  color: #f8f8f2;
}

ToastNotification[type="info"] QPushButton#action_button {
  background-color: #6272a4;
  color: #f8f8f2;
  border: 1px solid #6272a4;
  border-radius: 4px;
  padding: 5px 12px;
  font-weight: bold;
}

ToastNotification[type="info"] QPushButton#action_button:hover {
  background-color: #7d88b3;
  border-color: #7d88b3;
}

/* Toast type-specific styles - SUCCESS */
ToastNotification[type="success"] {
  background-color: #2d5a3d;
  border: 1px solid #3d6a4d;
  border-radius: 8px;
}

ToastNotification[type="success"] QLabel {
  color: #e0e0e4;
}

ToastNotification[type="success"] QPushButton#action_button {
  background-color: #3d6a4d;
  color: #e0e0e4;
  border: 1px solid #3d6a4d;
  border-radius: 4px;
  padding: 5px 12px;
  font-weight: bold;
}

ToastNotification[type="success"] QPushButton#action_button:hover {
  background-color: #4d7a5d;
  border-color: #4d7a5d;
}

/* Toast type-specific styles - WARNING */
ToastNotification[type="warning"] {
  background-color: #5a4a2d;
  border: 1px solid #6a5a3d;
  border-radius: 8px;
}

ToastNotification[type="warning"] QLabel {
  color: #e0e0e4;
}

ToastNotification[type="warning"] QPushButton#action_button {
  background-color: #6a5a3d;
  color: #e0e0e4;
  border: 1px solid #6a5a3d;
  border-radius: 4px;
  padding: 5px 12px;
  font-weight: bold;
}

ToastNotification[type="warning"] QPushButton#action_button:hover {
  background-color: #7a6a4d;
  border-color: #7a6a4d;
}

/* Toast type-specific styles - ERROR */
ToastNotification[type="error"] {
  background-color: #5a2d2d;
  border: 1px solid #6a3d3d;
  border-radius: 8px;
}

ToastNotification[type="error"] QLabel {
  color: #e0e0e4;
}

ToastNotification[type="error"] QPushButton#action_button {
  background-color: #6a3d3d;
  color: #e0e0e4;
  border: 1px solid #6a3d3d;
  border-radius: 4px;
  padding: 5px 12px;
  font-weight: bold;
}

ToastNotification[type="error"] QPushButton#action_button:hover {
  background-color: #7a4d4d;
  border-color: #7a4d4d;
}

/* ---- NOTIFICATION CENTER ---- */
NotificationCenter {
    background-color: #1a1a22;
}

NotificationCenter QListWidget {
    background-color: #1a1a22;
    alternate-background-color: transparent;
    border: 1px solid #3a3a50;
    border-radius: 6px;
    outline: none;
}


NotificationCenter QListWidget::item {
    background-color: transparent;
    border: none;
    outline: none;
}

NotificationCenter QListWidget::item:alternate {
    background-color: transparent;
}

NotificationCenter QListWidget::item:selected,
NotificationCenter QListWidget::item:hover,
NotificationCenter QListWidget::item:focus {
    background-color: transparent;
    border: none;
    outline: none;
}


QWidget#notification_item {
    background-color: #222230;
    border: 1px solid transparent; 
    border-radius: 6px;
    margin: 2px 4px;
}

QWidget#notification_item:hover {
    background-color: #28283a;
    border: 1px solid #3a3a50;
}

NotificationCenter QLabel {
    color: #e0e0e4;
    background-color: transparent;
}

NotificationCenter QComboBox {
    background-color: #222230;
    color: #e0e0e4;
    border: 1px solid #3a3a50;
    border-radius: 4px;
    padding: 3px 7px;
}

NotificationCenter QPushButton {
    background-color: #2d2d40;
    color: #e0e0e4;
    border: 1px solid #3a3a50;
    border-radius: 6px;
    padding: 4px 12px;
}

NotificationCenter QPushButton:hover {
    background-color: #353550;
}

QWidget#notification_item QPushButton#close_button {
    background-color: transparent;
    border: none;
    color: #8a8a98;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 14px;
    font-weight: bold;
    border-radius: 12px;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    padding: 0px;
    margin: 0px;
    qproperty-text: "✕";
}

/* Состояние при наведении */
QWidget#notification_item QPushButton#close_button:hover {
    background-color: #ef5555;
    color: #ffffff;
}

/* Состояние при клике */
QWidget#notification_item QPushButton#close_button:pressed {
    background-color: #d03030;
}
